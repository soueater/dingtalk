# ============================================================
# 望舒（stitch）—— 版本控制忽略规则
# 原则：源码、文档、配置、图标源与图标产物入库；
#       依赖、构建中间物、打包产物、历史归档一律不入库。
# ============================================================

# ---------------------------- 依赖 ----------------------------
node_modules/

# ---------------------------- 构建中间物 ----------------------------
dist/
app/scripts/__pipeline_stub__/
app/scripts/__editor_stub__/

# ---------------------------- 打包产物 ----------------------------
# 均为 electron-builder 生成，体积以百 MB 计，可由源码重建
app/out/
app/_old_builds/
app/package/
app/package-out/
app/pkg/
app/release/
app/release-out/
app/.shots/

# ---------------------------- 二进制 / 安装包兜底 ----------------------------
*.exe
*.nsis.7z

# ---------------------------- 日志与临时文件 ----------------------------
*.log
npm-debug.log*
.vite/

# ---------------------------- 系统 / 编辑器 ----------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---------------------------- 本地环境变量（严禁入库） ----------------------------
.env
.env.*
!.env.example
